## API ROUTE TEMPLATE
```js
import { assertUserId } from '../../src/shared/utils/backend/userRequest';
import { isJsonMode, getMongoCollection } from '../../lib/dataSource';

export default async function handler(req, res) {
  const userId = assertUserId(req, res);  // validates token + userId, sends 400/401 on fail
  if (!userId) return;
  if (isJsonMode()) return res.status(501).json({ error: 'Requires MongoDB' });

  const col = await getMongoCollection('collectionName'); // camelCase
  // ALWAYS include { userId } in every MongoDB filter
  if (req.method === 'GET') { ... }
  if (req.method === 'POST') { ... }
  return res.status(405).end();
}
```
- `userId` sources: `req.query.userId` → `req.body.userId` → `req.headers['x-user-id']`
- `_id`: use `crypto.randomBytes(12).toString('hex')` for manual IDs
- Some routes use `assertApiToken()` + `assertUserId()` separately instead of a single helper; keep behavior consistent per file

